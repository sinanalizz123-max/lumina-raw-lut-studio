<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (API 23-30): narrow durable set only. Projects are intentionally
    not included here because original camera files can exceed the Auto Backup
    quota; restore must report missing source media instead of pretending the
    originals were cloud-backed. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore" />
    <include domain="file" path="luts" />
    <exclude domain="file" path="projects" />
    <exclude domain="file" path=".trash" />
    <exclude domain="file" path="db-backup" />
    <exclude domain="file" path="db-recovery" />
</full-backup-content>
