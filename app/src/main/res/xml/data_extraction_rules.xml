<?xml version="1.0" encoding="utf-8"?>
<!-- Backup + device transfer (API 31+): only durable data is included. The
    cache dir is never backed up by the platform, and all disposable previews,
    thumbnails and temporary files live only there (see ProjectStore). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="projects" />
        <include domain="file" path="luts" />
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="projects" />
        <include domain="file" path="luts" />
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
